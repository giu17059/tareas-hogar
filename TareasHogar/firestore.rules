rules_version = '2';

// Pegar en Firebase Console > Firestore Database > Reglas > Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      // Lectura abierta a usuarios logueados para poder buscar una familia por código.
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // Un miembro puede editar la familia; alguien de afuera solo puede agregarse a sí mismo.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.auth.uid in request.resource.data.members)
      );
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, write: if isMember(familyId);
      }
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }
  }
}
